# 提示词版本
# v1  效果中等，速度快
# v2  效果提升，不过耗时也增加
PROMPTVISION=v1

# Optional Hugging Face endpoint. Leave on the canonical host unless you have
# verified that a private mirror preserves Hugging Face metadata and redirects.
HF_ENDPOINT=https://huggingface.co

# 本地启动地址；指定端口被占用时，一键启动器会自动选择下一个可用端口
HOST=127.0.0.1
PORT=8000

BASE_URL=https://api.deepseek.com
API_KEY=sk-xx
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0
ENABLE_THINKING=False
# 单次模型响应上限，以及关系抽取的主动分批大小
AI_MAX_OUTPUT_TOKENS=8192
# 大多数兼容接口使用 max_tokens；部分新模型要求 max_completion_tokens
AI_MAX_OUTPUT_PARAMETER=max_tokens
RELATION_TEXT_BATCH_CHARS=2048
RELATION_SOURCE_BATCH_SIZE=20
RELATION_MAX_SPLIT_DEPTH=10
# 每处理多少个文本块生成一次可恢复图谱检查点；暂停或完成时仍会立即保存
CHECKPOINT_INTERVAL=10
# 每批并行处理的文本块数；需确认服务商限流允许，建议 2-4
KG_WORKER_COUNT=4
# 百万字数文件可关闭重复关系的二次 AI 融合以减少大量请求，默认开启
KG_FUSION_ENABLED=True
# 超大图谱跳过 PageRank 迭代（仅影响节点视觉大小），默认最多计算 5000 个节点
GRAPH_PAGERANK_MAX_NODES=5000
# 社区详情页的最小节点数；设置为 1 可生成并列出所有社区
GRAPH_COMMUNITY_MIN_SIZE=1
FALLBACK_ENABLED=False
FALLBACK_BASE_URL=https://backup.example.com/v1
FALLBACK_API_KEY=sk-backup-xx
FALLBACK_MODEL_NAME=backup-model
# 首次部署时自动导入仓库内置的已完成示例；不会覆盖任何同名数据
DEFAULT_EXAMPLES_ENABLED=True

# 多模态模型
VL_API_KEY=sk-xx
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-vl-max-latest

# embeddings
# 是否使用本地路径加载模型
IS_USE_LOCAL=True
EMBEDDINGS=BAAI/bge-base-zh
EMBEDDINGS_PATH=../models/bge-base-zh

# rerank模型
RERANK_MODEL=../models/bge-reranker-base

# 文本分割模式
# SemanticTextSplitter   or    SimpleTextSplitter
SIMPLE=[txt,pdf]
SEMANTIC=[]
CHARACTER=[md]

# chroma_data
CHROMADB_PATH=./chroma_data

# 是否使用CUDA或者cpu
DEVICE=cpu

# 文件保存路径
UPLOAD_FOLDER=uploads
TXT_FOLDER=txt_files
RESULT_FOLDER=results
